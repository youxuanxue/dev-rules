#!/usr/bin/env bash

set -euo pipefail

resolve_source() {
    local source_path="$1"
    while [[ -L "$source_path" ]]; do
        local source_dir link_target
        source_dir="$(cd "$(dirname "$source_path")" && pwd)"
        link_target="$(readlink "$source_path")"
        if [[ "$link_target" = /* ]]; then
            source_path="$link_target"
        else
            source_path="$source_dir/$link_target"
        fi
    done
    cd "$(dirname "$source_path")" && pwd
}

bin_dir="$(resolve_source "${BASH_SOURCE[0]}")"
dev_rules_root="${DEV_RULES:-}"
if [[ -z "$dev_rules_root" ]]; then
    dev_rules_root="$(cd "$bin_dir/../.." && pwd)"
fi
if [[ ! -f "$dev_rules_root/scripts/twin/__main__.py" ]]; then
    echo "twin: cannot locate dev-rules runtime at $dev_rules_root" >&2
    exit 2
fi
dev_rules_root="$(cd "$dev_rules_root" && pwd)"

export DEV_RULES="$dev_rules_root"
export PYTHONPATH="$dev_rules_root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m scripts.twin "$@"
