#!/usr/bin/env bash
#
# wts — create an isolated git worktree (shared-submodule layout) and start an
# interactive agent session in the current terminal (Cursor Agent CLI / Codex /
# Claude Code / Gemini CLI / Kimi Code CLI / DeepSeek Harness).
#
# Canonical source: dev-rules/global/bin/wts (symlinked to ~/.local/bin/wts by sync.sh).
# Under the hood: git-worktree-submodule/scripts/wtree.py
#
# Usage:
#   wts <slug> [runtime]              # create + exec (default runtime: agent)
#   wts open <path-or-slug> [runtime]
#   wts --iterm <slug> [runtime]
#   wts --help                        # runtimes / options / examples
set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  wts <slug> [runtime]
      Create ../<repo>-wt-<slug> from origin/main (branch chore/<slug>) and
      start a session in that worktree. Bare slugs never mean an in-repo dir.
      Default runtime: agent. Default launch: current terminal (not iTerm).

  wts open <path-or-slug> [runtime]
      Attach a session to an existing worktree (no create).

  wts create <slug> [runtime]
      Same as the default create path (explicit subcommand).

Runtimes:
  agent     Cursor Agent CLI — agent --workspace <wt> --trust  (default)
  codex     Codex CLI        — codex -C <wt> [--model …]
  claude    Claude Code      — claude [--model …]
  gemini    Gemini CLI       — gemini --yolo [--model …]
  kimi      Kimi Code CLI    — kimi [--model …]
  dsh       DeepSeek Harness — dsh web  (model via ~/.dsh/settings.yaml)
  ide       Open Cursor IDE window on the worktree (no CLI agent)

  Aliases: cursor→agent, cursor-ide→ide, gemini-cli→gemini,
           kimi-code→kimi, deepseek|deepseek-harness→dsh

Options:
  --repo PATH    Superproject path (default: git root from cwd)
  --model MODEL  Forward --model to claude / codex / gemini / kimi only
  --iterm        Open a new iTerm window instead of the current terminal
  --here         Current terminal (default; accepted for compatibility)
  --self-test    Run launcher self-tests and exit
  -h, --help     Show this help

Examples:
  cd ~/Codes/sub2api && wts prob
  cd ~/Codes/sub2api && wts prob codex
  cd ~/Codes/sub2api && wts prob gemini --model gemini-3.8-flash
  cd ~/Codes/sub2api && wts prob kimi
  cd ~/Codes/sub2api && wts prob kimi --model <alias-from-config.toml>
  cd ~/Codes/sub2api && wts prob dsh
  cd ~/Codes/sub2api && wts --iterm prob agent
  cd ~/Codes/sub2api && wts open prob
  cd ~/Codes/sub2api && wts open ../sub2api-wt-prob kimi

Notes:
  • Reuses ../<repo>-wt-<slug> if it already exists.
  • kimi first run: inside the TUI, /login (OAuth or Platform API key).
  • kimi binary: ~/.kimi-code/bin/kimi (official install) or PATH / KIMI_BIN.
  • agent / ide / dsh do not accept --model.

Environment:
  WTREE_SCRIPT   Override path to wtree.py
  AGENT_BIN / CODEX_BIN / CLAUDE_BIN / GEMINI_BIN / KIMI_BIN / DSH_BIN
  WTS_HERE=0     Same as --iterm
EOF
}

die() {
    echo "wts: $*" >&2
    exit 1
}

resolve_wtree_script() {
    if [[ -n "${WTREE_SCRIPT:-}" && -f "$WTREE_SCRIPT" ]]; then
        echo "$WTREE_SCRIPT"
        return 0
    fi
    local bin_dir candidates candidate
    bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    candidates=(
        "$bin_dir/../.cursor/skills/git-worktree-submodule/scripts/wtree.py"
        "$HOME/Codes/dev-rules/.cursor/skills/git-worktree-submodule/scripts/wtree.py"
        "$HOME/Codes/agent-skills/git-worktree-submodule/scripts/wtree.py"
    )
    for candidate in "${candidates[@]}"; do
        if [[ -f "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    die "cannot find wtree.py — run dev-rules/sync.sh or set WTREE_SCRIPT"
}

resolve_repo() {
    local repo="${1:-.}"
    if [[ "$repo" != "." ]]; then
        repo="$(cd "$repo" && pwd)"
    elif git rev-parse --show-toplevel >/dev/null 2>&1; then
        repo="$(git rev-parse --show-toplevel)"
    else
        die "not inside a git repository — pass --repo PATH"
    fi
    echo "$repo"
}

worktree_from_json() {
    local json
    json="$(cat)"
    if [[ -z "${json//[[:space:]]/}" ]]; then
        die "wtree create produced no JSON output (see wtree error above)"
    fi
    python3 -c 'import json,sys; print(json.load(sys.stdin)["worktree"])' <<<"$json"
}

is_path_arg() {
    case "$1" in
        /* | ~ | ~/* | . | .. | ./* | ../* | */*) return 0 ;;
        *) return 1 ;;
    esac
}

expand_path_arg() {
    local raw="$1"
    case "$raw" in
        "~") echo "$HOME" ;;
        "~/"*) echo "$HOME/${raw#~/}" ;;
        *) echo "$raw" ;;
    esac
}

resolve_explicit_path() {
    local raw
    raw="$(expand_path_arg "$1")"
    if [[ -d "$raw" ]]; then
        echo "$(cd "$raw" && pwd)"
        return 0
    fi
    return 1
}

resolve_default_worktree() {
    local repo="$1"
    local slug="$2"
    local repo_name parent candidate
    repo_name="$(basename "$repo")"
    parent="$(cd "$repo/.." && pwd)"
    candidate="${parent}/${repo_name}-wt-${slug}"
    if [[ -d "$candidate" ]]; then
        echo "$candidate"
        return 0
    fi
    if [[ "$slug" == "${repo_name}-wt-"* ]]; then
        candidate="${parent}/${slug}"
        if [[ -d "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    fi
    return 1
}

resolve_worktree_slug() {
    local repo="$1"
    local slug="$2"

    # Bare slugs never mean a cwd-relative directory. Otherwise `wts deploy`
    # reuses an in-repo `deploy/` folder instead of ../<repo>-wt-deploy.
    if is_path_arg "$slug" && resolve_explicit_path "$slug"; then
        return 0
    fi
    resolve_default_worktree "$repo" "$slug"
}

resolve_open_target() {
    local repo="$1"
    local raw="$2"

    if resolve_worktree_slug "$repo" "$raw"; then
        return 0
    fi

    die "open target not found: $raw (tried $(basename "$repo")-wt-${raw})"
}

normalize_runtime() {
    case "$1" in
        cursor | agent) echo "agent" ;;
        ide | cursor-ide) echo "ide" ;;
        gemini | gemini-cli) echo "gemini" ;;
        kimi | kimi-code) echo "kimi" ;;
        dsh | deepseek | deepseek-harness) echo "dsh" ;;
        codex | claude) echo "$1" ;;
        *)
            die "unknown runtime: $1 (expected agent, codex, claude, gemini, kimi, dsh, or ide)"
            ;;
    esac
}

resolve_named_bin() {
    local name="$1"
    local env_var="$2"
    local env_val="${!env_var:-}"
    if [[ -n "$env_val" && -x "$env_val" ]]; then
        echo "$env_val"
        return 0
    fi
    local found=""
    found="$(command -v "$name" 2>/dev/null || true)"
    if [[ -n "$found" && -x "$found" ]]; then
        echo "$found"
        return 0
    fi
    local candidate
    for candidate in "$HOME/.local/bin/$name" "/opt/homebrew/bin/$name" "/usr/local/bin/$name"; do
        if [[ -x "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    die "$name not found in PATH (set $env_var)"
}

resolve_gemini_bin() {
    resolve_named_bin gemini GEMINI_BIN
}

resolve_kimi_bin() {
    if [[ -n "${KIMI_BIN:-}" && -x "$KIMI_BIN" ]]; then
        echo "$KIMI_BIN"
        return 0
    fi
    local found=""
    found="$(command -v kimi 2>/dev/null || true)"
    if [[ -n "$found" && -x "$found" ]]; then
        echo "$found"
        return 0
    fi
    local candidate
    # Official install script places the binary under ~/.kimi-code/bin.
    for candidate in \
        "$HOME/.kimi-code/bin/kimi" \
        "$HOME/.local/bin/kimi" \
        "/opt/homebrew/bin/kimi" \
        "/usr/local/bin/kimi"; do
        if [[ -x "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    die "kimi not found in PATH (set KIMI_BIN; install: curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash)"
}

resolve_dsh_bin() {
    resolve_named_bin dsh DSH_BIN
}

resolve_agent_bin() {
    if [[ -n "${AGENT_BIN:-}" && -x "$AGENT_BIN" ]]; then
        echo "$AGENT_BIN"
        return 0
    fi
    if [[ -x "$HOME/.local/bin/agent" ]]; then
        echo "$HOME/.local/bin/agent"
        return 0
    fi
    local found=""
    found="$(command -v agent 2>/dev/null || true)"
    if [[ -n "$found" && -x "$found" ]]; then
        echo "$found"
        return 0
    fi
    die "agent not found in PATH (set AGENT_BIN)"
}

prepare_agent_cli() {
    local worktree="$1"
    WTS_AGENT_BIN="$(resolve_agent_bin)"
    WTS_AGENT_WORKTREE="$(cd "$worktree" && pwd)"
    # agent shell-integration (zsh) exports CURSOR_AGENT_CHAT_ID and wraps `agent()`
    # with --resume; inheriting that ID can silently keep edits on the main checkout.
    unset CURSOR_AGENT_CHAT_ID
    export WTREE_SESSION_WORKDIR="$WTS_AGENT_WORKTREE"
    echo "worktree: $WTS_AGENT_WORKTREE"
    echo "session-workdir: $WTS_AGENT_WORKTREE"
}

ensure_worktree_skill_links() {
    local worktree="$1"
    if [[ -d "$worktree/.cursor/skills" ]]; then
        mkdir -p "$worktree/.agents" "$worktree/.claude" "$worktree/.codex" 2>/dev/null || true
        if [[ ! -e "$worktree/.agents/skills" && ! -L "$worktree/.agents/skills" ]]; then
            ln -s ../.cursor/skills "$worktree/.agents/skills" 2>/dev/null || true
        fi
        if [[ ! -e "$worktree/.claude/skills" && ! -L "$worktree/.claude/skills" ]]; then
            ln -s ../.cursor/skills "$worktree/.claude/skills" 2>/dev/null || true
        fi
        if [[ ! -e "$worktree/.codex/skills" && ! -L "$worktree/.codex/skills" ]]; then
            ln -s ../.cursor/skills "$worktree/.codex/skills" 2>/dev/null || true
        fi
    fi
}

session_command() {
    local runtime="$1"
    local worktree="$2"
    local model="$3"
    local -a cmd=()

    case "$runtime" in
        agent)
            prepare_agent_cli "$worktree"
            cmd=("$WTS_AGENT_BIN" "--workspace" "$WTS_AGENT_WORKTREE" "--trust")
            worktree="$WTS_AGENT_WORKTREE"
            ;;
        codex)
            local codex_bin="${CODEX_BIN:-$(command -v codex 2>/dev/null || true)}"
            [[ -n "$codex_bin" ]] || die "codex not found in PATH (set CODEX_BIN)"
            cmd=("$codex_bin" "-C" "$worktree")
            if [[ -n "$model" ]]; then
                cmd+=("--model" "$model")
            fi
            ;;
        claude)
            local claude_bin="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"
            [[ -x "$claude_bin" ]] || die "claude not found in PATH (set CLAUDE_BIN)"
            cmd=("$claude_bin")
            if [[ -n "$model" ]]; then
                cmd+=("--model" "$model")
            fi
            ;;
        gemini)
            local gemini_bin
            gemini_bin="$(resolve_gemini_bin)"
            cmd=("$gemini_bin" "--yolo")
            if [[ -n "$model" ]]; then
                cmd+=("--model" "$model")
            fi
            ;;
        kimi)
            local kimi_bin
            kimi_bin="$(resolve_kimi_bin)"
            cmd=("$kimi_bin")
            if [[ -n "$model" ]]; then
                cmd+=("--model" "$model")
            fi
            ;;
        dsh)
            local dsh_bin
            dsh_bin="$(resolve_dsh_bin)"
            # Official interactive surface is Web UI (developer preview); cwd is the workspace.
            cmd=("$dsh_bin" "web")
            ;;
        ide)
            ensure_worktree_skill_links "$worktree"
            python3 "$WTREE" open-workspace --worktree "$worktree"
            echo "worktree: $worktree"
            echo "→ 在新 Cursor IDE 窗口里新开 Agent Chat 继续"
            return 0
            ;;
        *)
            die "unknown runtime: $runtime"
            ;;
    esac

    launch_session "$worktree" "${cmd[@]}"
}

launch_session() {
    local worktree="$1"
    shift
    local -a cmd=("$@")

    ensure_worktree_skill_links "$worktree"

    if [[ "${WTS_HERE:-1}" -eq 1 ]] || [[ "$(uname -s)" != "Darwin" ]]; then
        cd "$worktree" || die "cd failed: $worktree"
        exec "${cmd[@]}"
    fi

    if ! osascript -e 'tell application "iTerm" to return version' >/dev/null 2>&1; then
        die "iTerm is not available — omit --iterm to use the current terminal"
    fi

    python3 - "$worktree" "${cmd[@]}" <<'PY'
import shlex
import subprocess
import sys

worktree = sys.argv[1]
cmd = sys.argv[2:]
inner = (
    "unset CURSOR_AGENT_CHAT_ID; "
    f"cd {shlex.quote(worktree)} && exec "
    + " ".join(shlex.quote(part) for part in cmd)
)
inner_esc = inner.replace("\\", "\\\\").replace('"', '\\"')
script = f'''tell application "iTerm"
  activate
  create window with default profile
  tell current session of current window
    write text "{inner_esc}"
  end tell
end tell'''
subprocess.run(["osascript", "-e", script], check=True)
PY

    echo "worktree: $worktree"
    echo "→ iTerm session: ${cmd[*]}"
}

create_worktree() {
    local repo="$1"
    local slug="$2"
    local existing=""

    if existing="$(resolve_worktree_slug "$repo" "$slug")"; then
        echo "$existing"
        return 0
    fi

    python3 "$WTREE" create --repo "$repo" --no-open-workspace --json "$slug" | worktree_from_json
}

cmd_self_test() {
    local self tmp repo worktree argv_file output_file fails
    fails=0
    self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    tmp="$(mktemp -d)"
    trap 'rm -r "$tmp"' RETURN

    repo="$tmp/repo"
    worktree="$tmp/worktree"
    argv_file="$tmp/claude-argv"
    output_file="$tmp/output"
    mkdir -p "$repo" "$worktree"

    cat > "$tmp/wtree.py" <<'PY'
import json
import os

print(json.dumps({"worktree": os.environ["WTS_SELF_TEST_WORKTREE"]}))
PY
    cat > "$tmp/claude" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$WTS_SELF_TEST_ARGV"
SH
    chmod +x "$tmp/claude"

    echo "=== wts self-test ==="
    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        CLAUDE_BIN="$tmp/claude" WTS_SELF_TEST_ARGV="$argv_file" \
        "$self" --repo "$repo" seedance claude --model gpt-5.6 \
        >"$output_file" 2>&1 \
        && [[ "$(printf '%s\n' --model gpt-5.6)" == "$(cat "$argv_file")" ]]; then
        echo "  ok: claude receives --model"
    else
        echo "  x claude did not receive --model gpt-5.6"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    gemini_argv_file="$tmp/gemini-argv"
    cat > "$tmp/gemini" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$WTS_SELF_TEST_ARGV"
SH
    chmod +x "$tmp/gemini"

    codex_argv_file="$tmp/codex-argv"
    cat > "$tmp/codex" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$WTS_SELF_TEST_ARGV"
SH
    chmod +x "$tmp/codex"

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        CODEX_BIN="$tmp/codex" WTS_SELF_TEST_ARGV="$codex_argv_file" \
        "$self" --repo "$repo" seedance codex --model glm-5.3 \
        >"$output_file" 2>&1 \
        && [[ "$(printf '%s\n' -C "$worktree" --model glm-5.3)" == "$(cat "$codex_argv_file")" ]]; then
        echo "  ok: codex receives --model"
    else
        echo "  x codex did not receive --model glm-5.3"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        GEMINI_BIN="$tmp/gemini" WTS_SELF_TEST_ARGV="$gemini_argv_file" \
        "$self" --repo "$repo" seedance gemini --model gemini-3.8-flash \
        >"$output_file" 2>&1 \
        && [[ "$(printf '%s\n' --yolo --model gemini-3.8-flash)" == "$(cat "$gemini_argv_file")" ]]; then
        echo "  ok: gemini receives --model"
    else
        echo "  x gemini did not receive --model gemini-3.8-flash"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        GEMINI_BIN="$tmp/gemini" WTS_SELF_TEST_ARGV="$gemini_argv_file" \
        "$self" --repo "$repo" seedance gemini \
        >"$output_file" 2>&1 \
        && [[ "$(printf '%s\n' --yolo)" == "$(cat "$gemini_argv_file")" ]]; then
        echo "  ok: gemini succeeds without --model"
    else
        echo "  x gemini failed without --model"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if "$self" --repo "$repo" seedance claude --model >"$output_file" 2>&1; then
        echo "  x --model without a value succeeded"
        fails=$((fails + 1))
    elif grep -qF -- '--model requires a value' "$output_file"; then
        echo "  ok: --model requires a value"
    else
        echo "  x --model without a value returned the wrong error"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        "$self" --repo "$repo" seedance agent --model gpt-5.6 \
        >"$output_file" 2>&1; then
        echo "  x agent accepted unsupported --model option"
        fails=$((fails + 1))
    elif grep -qF -- '--model is only supported with the claude, codex, gemini, and kimi runtimes' "$output_file"; then
        echo "  ok: --model rejects unsupported runtimes"
    else
        echo "  x unsupported --model returned the wrong error"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    kimi_argv_file="$tmp/kimi-argv"
    cat > "$tmp/kimi" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$WTS_SELF_TEST_ARGV"
SH
    chmod +x "$tmp/kimi"

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        KIMI_BIN="$tmp/kimi" WTS_SELF_TEST_ARGV="$kimi_argv_file" \
        "$self" --repo "$repo" seedance kimi --model kimi-for-coding \
        >"$output_file" 2>&1 \
        && [[ "$(printf '%s\n' --model kimi-for-coding)" == "$(cat "$kimi_argv_file")" ]]; then
        echo "  ok: kimi receives --model"
    else
        echo "  x kimi did not receive --model kimi-for-coding"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        KIMI_BIN="$tmp/kimi" WTS_SELF_TEST_ARGV="$kimi_argv_file" \
        "$self" --repo "$repo" seedance kimi \
        >"$output_file" 2>&1 \
        && [[ -z "$(cat "$kimi_argv_file")" ]]; then
        echo "  ok: kimi succeeds without --model"
    else
        echo "  x kimi failed without --model"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    dsh_argv_file="$tmp/dsh-argv"
    cat > "$tmp/dsh" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$WTS_SELF_TEST_ARGV"
SH
    chmod +x "$tmp/dsh"

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        DSH_BIN="$tmp/dsh" WTS_SELF_TEST_ARGV="$dsh_argv_file" \
        "$self" --repo "$repo" seedance dsh \
        >"$output_file" 2>&1 \
        && [[ "$(printf '%s\n' web)" == "$(cat "$dsh_argv_file")" ]]; then
        echo "  ok: dsh launches web profile"
    else
        echo "  x dsh did not launch web profile"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        DSH_BIN="$tmp/dsh" WTS_SELF_TEST_ARGV="$dsh_argv_file" \
        "$self" --repo "$repo" seedance deepseek \
        >"$output_file" 2>&1 \
        && [[ "$(printf '%s\n' web)" == "$(cat "$dsh_argv_file")" ]]; then
        echo "  ok: deepseek alias maps to dsh"
    else
        echo "  x deepseek alias did not map to dsh"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if WTS_SELF_TEST_WORKTREE="$worktree" WTREE_SCRIPT="$tmp/wtree.py" \
        DSH_BIN="$tmp/dsh" \
        "$self" --repo "$repo" seedance dsh --model deepseek-v4-flash \
        >"$output_file" 2>&1; then
        echo "  x dsh accepted unsupported --model option"
        fails=$((fails + 1))
    elif grep -qF -- '--model is only supported with the claude, codex, gemini, and kimi runtimes' "$output_file"; then
        echo "  ok: --model rejects dsh runtime"
    else
        echo "  x dsh --model returned the wrong error"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    reuse_repo="$tmp/reuse-repo"
    reuse_wt="$tmp/reuse-repo-wt-existing"
    mkdir -p "$reuse_repo" "$reuse_wt"
    cat > "$tmp/wtree-reuse.py" <<'PY'
import sys

if "open-workspace" in sys.argv:
    sys.exit(0)
print("create should not be called", file=sys.stderr)
sys.exit(1)
PY
    if WTREE_SCRIPT="$tmp/wtree-reuse.py" "$self" --repo "$reuse_repo" existing ide \
        >"$output_file" 2>&1 \
        && grep -qF "worktree: $reuse_wt" "$output_file"; then
        echo "  ok: reuses existing default worktree slug"
    else
        echo "  x did not reuse existing default worktree slug"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if WTREE_SCRIPT="$tmp/wtree-reuse.py" "$self" --repo "$reuse_repo" reuse-repo-wt-existing ide \
        >"$output_file" 2>&1 \
        && grep -qF "worktree: $reuse_wt" "$output_file"; then
        echo "  ok: reuses full <repo>-wt-<slug> name"
    else
        echo "  x did not reuse full <repo>-wt-<slug> name"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    # Skill links self-test
    skills_repo="$tmp/skills-repo"
    skills_wt="$tmp/skills-repo-wt-test"
    mkdir -p "$skills_repo/.cursor/skills/demo-skill" "$skills_wt/.cursor/skills/demo-skill"
    touch "$skills_wt/.cursor/skills/demo-skill/SKILL.md"
    if WTS_SELF_TEST_WORKTREE="$skills_wt" WTREE_SCRIPT="$tmp/wtree.py" \
        GEMINI_BIN="$tmp/gemini" WTS_SELF_TEST_ARGV="$gemini_argv_file" \
        "$self" --repo "$skills_repo" test gemini >"$output_file" 2>&1 \
        && [[ -L "$skills_wt/.agents/skills" ]] \
        && [[ -L "$skills_wt/.claude/skills" ]] \
        && [[ -L "$skills_wt/.codex/skills" ]]; then
        echo "  ok: ensures worktree skill consumer links"
    else
        echo "  x failed to ensure worktree skill consumer links"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi


    if WTREE_SCRIPT="$tmp/wtree-reuse.py" "$self" --repo "$reuse_repo" open "$reuse_wt" ide \
        >"$output_file" 2>&1 \
        && grep -qF "worktree: $reuse_wt" "$output_file"; then
        echo "  ok: open accepts explicit worktree path"
    else
        echo "  x open did not accept explicit worktree path"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    collision_root="$tmp/collision"
    collision_repo="$collision_root/repo"
    collision_inrepo="$collision_repo/deploy"
    collision_wt="$collision_root/repo-wt-created"
    mkdir -p "$collision_inrepo" "$collision_wt"
    cat > "$tmp/wtree-collision.py" <<'PY'
import json
import os
import sys

if "open-workspace" in sys.argv:
    sys.exit(0)
if "create" not in sys.argv:
    print("expected create", file=sys.stderr)
    sys.exit(1)
print(json.dumps({"worktree": os.environ["WTS_SELF_TEST_WORKTREE"]}))
PY
    if (
        cd "$collision_repo" &&
        WTS_SELF_TEST_WORKTREE="$collision_wt" WTREE_SCRIPT="$tmp/wtree-collision.py" \
            "$self" --repo "$collision_repo" deploy ide
    ) >"$output_file" 2>&1 \
        && grep -qF "worktree: $collision_wt" "$output_file" \
        && ! grep -qF "worktree: $collision_inrepo" "$output_file"; then
        echo "  ok: bare slug ignores in-repo directory"
    else
        echo "  x bare slug reused in-repo directory"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if (
        cd "$collision_repo" &&
        WTREE_SCRIPT="$tmp/wtree-reuse.py" "$self" --repo "$collision_repo" open deploy ide
    ) >"$output_file" 2>&1; then
        echo "  x open bare slug reused in-repo directory"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    elif grep -qF "open target not found: deploy" "$output_file"; then
        echo "  ok: open bare slug ignores in-repo directory"
    else
        echo "  x open bare slug returned the wrong error"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if (
        cd "$collision_repo" &&
        WTREE_SCRIPT="$tmp/wtree-reuse.py" "$self" --repo "$collision_repo" ./deploy ide
    ) >"$output_file" 2>&1 \
        && grep -qF "worktree: $collision_inrepo" "$output_file"; then
        echo "  ok: explicit relative path still opens that directory"
    else
        echo "  x explicit relative path was not honored"
        sed 's/^/      /' "$output_file"
        fails=$((fails + 1))
    fi

    if [[ "$fails" -eq 0 ]]; then
        echo "=== self-test PASS ==="
        return 0
    fi
    echo "=== self-test FAIL: $fails ==="
    return 1
}

main() {
    local cmd="create"
    local repo="."
    local slug=""
    local runtime="agent"
    local model=""
    WTS_HERE="${WTS_HERE:-1}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h | --help)
                usage
                exit 0
                ;;
            --self-test)
                cmd_self_test
                exit
                ;;
            --repo)
                [[ $# -ge 2 ]] || die "--repo requires a path"
                repo="$2"
                shift 2
                ;;
            --model)
                [[ $# -ge 2 ]] || die "--model requires a value"
                model="$2"
                shift 2
                ;;
            --iterm)
                WTS_HERE=0
                shift
                ;;
            --here)
                WTS_HERE=1
                shift
                ;;
            open)
                cmd="open"
                shift
                ;;
            create)
                cmd="create"
                shift
                ;;
            agent | cursor | codex | claude | gemini | gemini-cli | kimi | kimi-code | dsh | deepseek | deepseek-harness | ide | cursor-ide)
                runtime="$(normalize_runtime "$1")"
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                die "unknown option: $1"
                ;;
            *)
                if [[ -z "$slug" ]]; then
                    slug="$1"
                else
                    runtime="$(normalize_runtime "$1")"
                fi
                shift
                ;;
        esac
    done

    [[ -n "$slug" ]] || {
        usage >&2
        exit 1
    }
    [[ -z "$model" || "$runtime" == "claude" || "$runtime" == "codex" || "$runtime" == "gemini" || "$runtime" == "kimi" ]] || die "--model is only supported with the claude, codex, gemini, and kimi runtimes"

    WTREE="$(resolve_wtree_script)"
    repo="$(resolve_repo "$repo")"

    local worktree=""
    if [[ "$cmd" == "open" ]]; then
        worktree="$(resolve_open_target "$repo" "$slug")"
    else
        worktree="$(create_worktree "$repo" "$slug")"
    fi

    session_command "$runtime" "$worktree" "$model"
}

main "$@"
