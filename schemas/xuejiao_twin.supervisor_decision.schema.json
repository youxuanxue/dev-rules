{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/xuejiao_twin.supervisor_decision.schema.json",
  "title": "xuejiao twin supervisor decision",
  "type": "object",
  "required": ["action", "current_focus", "instruction", "feature_updates", "ledger_updates", "reason"],
  "additionalProperties": false,
  "properties": {
    "action": { "type": "string", "enum": ["draft_ledger", "continue", "stop", "needs_human"] },
    "current_focus": { "type": ["string", "null"] },
    "instruction": { "type": "string", "maxLength": 2000 },
    "feature_updates": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "status", "validation_evidence", "blocked_reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "status": { "type": "string", "enum": ["pending", "in_progress", "blocked", "completed", "deferred"] },
          "validation_evidence": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
          "blocked_reason": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    },
    "ledger_updates": {
      "type": "object",
      "required": ["add_features", "update_features", "current_focus"],
      "additionalProperties": false,
      "properties": {
        "add_features": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["description", "acceptance"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "maxLength": 32 },
              "description": { "type": "string", "minLength": 1, "maxLength": 240 },
              "acceptance": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
              "blocked_reason": { "type": ["string", "null"], "maxLength": 1000 }
            }
          }
        },
        "update_features": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 32 },
              "description": { "type": "string", "maxLength": 240 },
              "acceptance": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
              "status": { "type": "string", "enum": ["pending", "in_progress", "blocked", "completed", "deferred"] },
              "blocked_reason": { "type": ["string", "null"], "maxLength": 1000 }
            }
          }
        },
        "current_focus": { "type": ["string", "null"], "maxLength": 32 }
      }
    },
    "reason": { "type": "string", "maxLength": 1000 }
  }
}
