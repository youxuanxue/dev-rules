{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/twin.human_response.schema.json",
  "title": "twin human response",
  "type": "object",
  "required": ["schema_version", "recorded_at", "text", "consumed_by_run_id"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "recorded_at": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "consumed_by_run_id": { "type": ["string", "null"] }
  }
}
