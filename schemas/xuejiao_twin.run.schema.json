{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/xuejiao_twin.run.schema.json",
  "title": "xuejiao twin worker run",
  "type": "object",
  "required": ["schema_version", "run_id", "workspace_ref", "goal_ref", "ledger_ref", "worker_persona_ref", "supervisor_persona_ref", "state_ref", "events_ref", "started_at", "ended_at", "worker", "instruction", "evidence", "outcome"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "run_id": { "type": "string", "minLength": 1 },
    "workspace_ref": { "type": "string", "minLength": 1 },
    "goal_ref": { "type": "string", "minLength": 1 },
    "ledger_ref": { "type": "string", "minLength": 1 },
    "worker_persona_ref": { "type": "string", "minLength": 1 },
    "supervisor_persona_ref": { "type": "string", "minLength": 1 },
    "state_ref": { "type": "string", "minLength": 1 },
    "events_ref": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "ended_at": { "type": "string", "minLength": 1 },
    "worker": {
      "type": "object",
      "required": ["session_hash", "resume_used", "permission_mode", "returncode", "session_lost"],
      "additionalProperties": false,
      "properties": {
        "session_hash": { "type": "string" },
        "resume_used": { "type": "boolean" },
        "permission_mode": { "type": "string" },
        "returncode": { "type": "integer" },
        "session_lost": { "type": "boolean" }
      }
    },
    "instruction": { "type": "string" },
    "evidence": {
      "type": "object",
      "required": ["worker_output", "changed_files", "validation", "git_status", "git_diff_stat"],
      "additionalProperties": false,
      "properties": {
        "worker_output": { "type": "string" },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "validation": { "type": "array", "items": { "type": "string" } },
        "git_status": { "type": "string" },
        "git_diff_stat": { "type": "string" }
      }
    },
    "review_ref": { "type": ["string", "null"] },
    "outcome": { "type": "string", "enum": ["review_required", "needs_human", "accepted_done", "failed"] }
  }
}
