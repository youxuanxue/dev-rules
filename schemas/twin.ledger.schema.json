{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/twin.ledger.schema.json",
  "title": "twin feature ledger",
  "type": "object",
  "required": ["schema_version", "goal_id", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "goal_id": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "deliverable", "scope", "covers_ac", "evidence_plan", "actual_evidence", "depends_on", "status", "next_action"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "deliverable": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "covers_ac": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence_plan": { "type": "array", "items": { "type": "string" } },
          "actual_evidence": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["pending", "in_progress", "blocked", "completed", "deferred"] },
          "next_action": { "type": "string" },
          "blocked_reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
