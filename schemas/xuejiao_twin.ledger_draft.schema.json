{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/xuejiao_twin.ledger_draft.schema.json",
  "title": "xuejiao twin ledger draft",
  "type": "object",
  "required": ["features", "current_focus", "reason"],
  "additionalProperties": false,
  "properties": {
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "description", "status", "acceptance", "validation_evidence", "blocked_reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 },
          "status": { "type": "string", "enum": ["pending", "in_progress", "blocked", "completed", "deferred"] },
          "acceptance": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "validation_evidence": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
          "blocked_reason": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    },
    "current_focus": { "type": ["string", "null"], "maxLength": 32 },
    "reason": { "type": "string", "maxLength": 1000 }
  }
}
