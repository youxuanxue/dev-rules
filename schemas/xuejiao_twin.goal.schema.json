{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/xuejiao_twin.goal.schema.json",
  "title": "xuejiao twin goal",
  "type": "object",
  "required": ["schema_version", "id", "one_liner", "core_goal", "acceptance_criteria", "non_goals"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "minLength": 1 },
    "one_liner": { "type": "string", "minLength": 1 },
    "core_goal": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "evidence_type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "evidence_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "non_goals": { "type": "array", "items": { "type": "string" } }
  }
}
