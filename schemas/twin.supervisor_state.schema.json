{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/twin.supervisor_state.schema.json",
  "title": "twin supervisor state",
  "type": "object",
  "required": ["schema_version", "workspace_id", "status", "round_index", "current_run_id", "current_item_id", "worker_session_id", "next_instruction", "last_review_status", "needs_human", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "workspace_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["idle", "worker_running", "review_required", "continue", "needs_human", "accepted_done", "failed"] },
    "round_index": { "type": "integer", "minimum": 0 },
    "current_run_id": { "type": ["string", "null"] },
    "current_item_id": { "type": ["string", "null"] },
    "worker_session_id": { "type": ["string", "null"] },
    "next_instruction": { "type": "string" },
    "last_review_status": { "type": ["string", "null"] },
    "state_revision": { "type": "integer", "minimum": 0 },
    "supervisor_route": { "enum": [null, "host/claude", "host/codex", "host/antigravity"] },
    "pending_action": {
      "type": ["object", "null"],
      "required": ["kind", "token", "state_revision", "run_id", "issued_at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["supervisor_instruction", "review_run"] },
        "token": { "type": "string", "minLength": 1 },
        "state_revision": { "type": "integer", "minimum": 0 },
        "run_id": { "type": ["string", "null"] },
        "issued_at": { "type": "string", "minLength": 1 }
      }
    },
    "needs_human": {
      "type": ["object", "null"],
      "required": ["question", "context", "created_at"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "created_at": { "type": "string", "minLength": 1 }
      }
    },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
