{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/xuejiao_twin.history_index.schema.json",
  "title": "xuejiao twin history index",
  "type": "object",
  "required": ["schema_version", "generated_at", "redaction_version", "sources", "turns", "privacy_report"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "redaction_version": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_ref", "source_type", "source_hash", "session_hash", "project_hash", "turn_count", "coverage_status"],
        "additionalProperties": true,
        "properties": {
          "source_ref": { "type": "string", "minLength": 1 },
          "source_type": {
            "type": "string",
            "enum": ["cursor_agent_transcript", "claude_project_jsonl", "claude_history", "cursor_store_metadata", "fixture"]
          },
          "source_hash": { "type": "string", "minLength": 8 },
          "session_hash": { "type": "string", "minLength": 8 },
          "project_hash": { "type": "string", "minLength": 8 },
          "turn_count": { "type": "integer", "minimum": 0 },
          "time_range": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "start": { "type": ["string", "null"] },
              "end": { "type": ["string", "null"] }
            }
          },
          "coverage_status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["turn_id", "source_ref", "role", "text_redacted", "content_hash", "tool_summary", "behavior_labels", "privacy_flags"],
        "additionalProperties": true,
        "properties": {
          "turn_id": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["user", "assistant", "system", "unknown"] },
          "timestamp": { "type": ["string", "null"] },
          "text_redacted": { "type": "string" },
          "content_hash": { "type": "string", "minLength": 8 },
          "tool_summary": { "type": "object", "additionalProperties": true },
          "behavior_labels": { "type": "array", "items": { "type": "string" } },
          "privacy_flags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "privacy_report": { "type": "object", "additionalProperties": true }
  }
}
