{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youxuanxue/dev-rules/schemas/xuejiao_twin.worker_result.schema.json",
  "title": "xuejiao twin worker result",
  "type": "object",
  "required": ["summary", "changed_files", "validation", "blockers", "needs_human"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "maxLength": 2000 },
    "changed_files": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
    "validation": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["command", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 500 },
          "returncode": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "type": "string", "enum": ["passed", "failed", "attempted", "missing"] },
          "evidence": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "blockers": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 1000 } },
    "needs_human": { "type": "boolean" }
  }
}
